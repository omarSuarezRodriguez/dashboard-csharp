{
  "name": "whatsapp-chat-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dashboard": "tsx watch --env-file=.env src/dashboardServer.ts",
    "setup": "tsx --env-file=.env src/setup/cli.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "configure": "tsx --env-file=.env scripts/configure-tenant.ts",
    "webhook:twilio": "tsx --env-file=.env scripts/set-whatsapp-webhook.ts",
    "send:test": "tsx --env-file=.env scripts/send-test.ts",
    "simulate": "tsx --env-file=.env scripts/simulate-inbound.ts",
    "sounds:messenger": "node scripts/download-messenger-sound.mjs",
    "sounds:whatsapp-web": "node scripts/download-whatsapp-web-sound.mjs",
    "go-live": "tsx --env-file=.env scripts/go-live.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^6.3.1",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "twilio": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
