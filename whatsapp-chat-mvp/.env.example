DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_chat
NODE_ENV=development
PORT=5001
DASHBOARD_PORT=5002
SYNC_INTERVAL_MS=1000
SYNC_HISTORY_DAYS=90
SYNC_RECENT_DAYS=14
ENCRYPTION_KEY=change-me-to-32-byte-hex-or-base64-key
LOG_LEVEL=info
SETUP_REQUIRED=false

# Twilio (también se guardan cifrados por tenant vía npm run configure)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+573242497352

# URL pública sin path (ngrok u otro). Debe coincidir con lo que Twilio llama.
WEBHOOK_BASE_URL=https://your-subdomain.ngrok-free.dev
TEST_WHATSAPP_TO=whatsapp:+573001234567
RESTAURANT_NAME=La Casa del Sabor
RESTAURANT_TIMEZONE=America/Bogota
TENANT_SLUG=demo
